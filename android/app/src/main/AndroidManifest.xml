<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Chuchu"
        android:extractNativeLibs="false">
        <activity
            android:name="com.jossephus.chuchu.MainActivity"
            android:enabled="true"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustNothing"
            android:theme="@style/Theme.Chuchu">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Telegram deep link, VERIFIED: the tailnet host serves
                 /.well-known/assetlinks.json naming this package + signing
                 fingerprint, so Android opens kohi straight from the tap —
                 no browser, no trampoline page, no second tap. Covers the
                 notification links (/kohi-focus/go) and the legacy
                 /kohi-open path. Verification needs the tailnet reachable;
                 if it does not take, "Open by default" in app settings does
                 the same thing by hand, and the browser path still works. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="the-real-witch.tail26a258.ts.net"
                    android:pathPrefix="/kohi-open" />
                <data
                    android:scheme="https"
                    android:host="the-real-witch.tail26a258.ts.net"
                    android:pathPrefix="/kohi-focus/go" />
            </intent-filter>
            <!-- kohi://open?host=<name> — launched by the dufs trampoline
                 page via Chrome's intent:// syntax; needs no verification. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kohi" android:host="open" />
            </intent-filter>
        </activity>

        <service
            android:name="com.jossephus.chuchu.service.terminal.SessionForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Maintains a live, interactive SSH/terminal session connection while the app is backgrounded so the remote shell and running commands are not dropped. This persistent interactive network session is not covered by camera, connectedDevice, dataSync, health, location, mediaPlayback, mediaProjection, microphone, phoneCall, or remoteMessaging types." />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
