<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Khôi phục chuỗi alarm sau reboot; không có thì alert nền tắt im lặng. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Xin miễn tối ưu pin (dialog hệ thống) — để mạng nền sống trong doze, alert không nổ trễ.
         App sideload cá nhân, không phát hành qua Play nên không vướng policy của quyền này. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Nhịp trực nền bằng alarm (13/10): xin quyền exact-alarm để nhịp đúng giờ khi máy
         idle; chưa cấp thì vẫn chạy inexact (trễ vài phút), Settings có nút xin. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Gửi broadcast tường minh tới app Tailscale (bật/tắt VPN bằng nút) cần khai gói này từ API 30. -->
    <queries>
        <package android:name="com.tailscale.ipn" />
    </queries>

    <application
        android:name=".ChuchuApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Chuchu"
        android:extractNativeLibs="false"
        android:enableOnBackInvokedCallback="false">
        <activity
            android:name="com.jossephus.chuchu.MainActivity"
            android:enabled="true"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Chuchu">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Telegram deep link, VERIFIED: the tailnet host serves
                 /.well-known/assetlinks.json naming this package + signing
                 fingerprint, so Android opens kohi straight from the tap —
                 no browser, no trampoline page, no second tap. Covers the
                 notification links (/kohi-focus/go) and the legacy
                 /kohi-open path. Verification needs the tailnet reachable;
                 if it does not take, "Open by default" in app settings does
                 the same thing by hand, and the browser path still works. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="the-real-witch.tail26a258.ts.net"
                    android:pathPrefix="/kohi-open" />
                <data
                    android:scheme="https"
                    android:host="the-real-witch.tail26a258.ts.net"
                    android:pathPrefix="/kohi-focus/go" />
                <!-- Short notification link: /k/<pane>. Telegram only opens a
                     link without its "open this link?" prompt when the text
                     IS the URL, so the link has to stay short enough to read
                     raw in the message. -->
                <data
                    android:scheme="https"
                    android:host="the-real-witch.tail26a258.ts.net"
                    android:pathPrefix="/k/" />
            </intent-filter>
            <!-- kohi://open?host=<name> — launched by the dufs trampoline
                 page via Chrome's intent:// syntax; needs no verification. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kohi" android:host="open" />
            </intent-filter>
        </activity>

        <!-- Bubble gắn thông báo agent (NEEDS YOU / XONG): cửa sổ nổi chỉ dựng
             BubbleShell. documentLaunchMode=always + taskAffinity rỗng = mỗi pane
             một bubble task riêng, không kéo theo task chính.
             18/10: bubble tự xử IME bằng Compose (safeDrawing ∪ ime). Để adjustResize
             thì cửa sổ bubble bị resize theo bàn phím, lúc hạ keyboard có một nhịp
             nền xám trước khi nội dung giãn lại; adjustNothing giữ cửa sổ cố định. -->
        <activity
            android:name="com.jossephus.chuchu.ui.bubble.AgentBubbleActivity"
            android:enabled="true"
            android:exported="false"
            android:launchMode="standard"
            android:documentLaunchMode="always"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustNothing"
            android:theme="@style/Theme.Chuchu" />

        <service
            android:name="com.jossephus.chuchu.service.terminal.SessionForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Maintains a live, interactive SSH/terminal session connection while the app is backgrounded so the remote shell and running commands are not dropped. This persistent interactive network session is not covered by camera, connectedDevice, dataSync, health, location, mediaPlayback, mediaProjection, microphone, phoneCall, or remoteMessaging types." />
        </service>

        <!-- Trực /state khi app xuống nền để nổi NEEDS YOU / XONG — bằng ALARM
             (13/10: bỏ FGS "watching" vì user không muốn thông báo thường trú;
             mỗi nhịp alarm thức dậy poll 1 phát, không notification nền). -->
        <receiver
            android:name="com.jossephus.chuchu.service.agents.AgentWatchReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name="com.jossephus.chuchu.service.agents.AgentBootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
